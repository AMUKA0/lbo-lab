# Everything the image does not need. node_modules and .venv especially: both
# are large, both are platform-specific, and both would be rebuilt inside the
# image anyway — copying them in is slower and can produce a broken install.
.git/
.gitignore
.venv/
venv/
**/node_modules/
**/__pycache__/
**/*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Built locally; the image builds its own in stage 1.
web/dist/
*.tsbuildinfo

# Not part of the running service.
tests/
.claude/
.idea/
.vscode/
README.md
Dockerfile
.dockerignore
